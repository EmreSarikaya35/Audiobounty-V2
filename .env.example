# Copy to .env and fill in. See the Configuration section of README.md.

# Your Kick app (kick.com → Settings → Developer)
KICK_CLIENT_ID=
KICK_CLIENT_SECRET=

# Public address of the site, no trailing slash
PUBLIC_URL=https://alerts.example.com

# Cloudflare Tunnel token (only for the default docker-compose.yml setup)
TUNNEL_TOKEN=

# Optional
# PORT=3000
# DATA_DIR=data
# MAX_SOUND_MB=5
# MAX_ALERTS=30
# SESSION_SECRET=
